{
  "name": "@vworlds/box2d3-wasm",
  "version": "6.0.0",
  "description": "Box2D v3 for the web and Node as WebAssembly: a flat C-style embind API plus a zero-allocation fast path.",
  "type": "module",
  "main": "./dist/entry.mjs",
  "module": "./dist/entry.mjs",
  "types": "./dist/entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "default": "./dist/entry.mjs"
    },
    "./fastpath": {
      "types": "./dist/fastpath.d.ts",
      "default": "./dist/fastpath.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:docker": "bash scripts/build-in-docker.sh",
    "test": "node tests/fastpath-differential.mjs deluxe && node tests/fastpath-differential.mjs compat && node tests/integration.mjs",
    "test:stock": "node tests/stock-differential/run.mjs",
    "gen": "python3 scripts/gen_fastpath.py",
    "gen:check": "python3 scripts/gen_fastpath.py --check",
    "demo:dev": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build"
  },
  "author": "Alex Birch & Erik Sombroek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vworlds/box2d3-wasm.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "box2d3-wasm": "5.2.0"
  }
}
