From abe2380a97fc3350d58922fd47572e89c08dfa21 Mon Sep 17 00:00:00 2001
From: scratch <jm@peletier.com>
Date: Tue, 13 Oct 2026 01:02:33 +0000
Subject: [PATCH 6/7] perf: scratch adapter R7 - pose-out reads entity objects
 by body index (local only)

---
 lib/vecs-physics/src/adapter/engine.ts | 3 +++
 lib/vecs-physics/src/body/lifecycle.ts | 1 +
 lib/vecs-physics/src/body/pose_out.ts  | 8 ++------
 lib/vecs-physics/src/core/reaper.ts    | 1 +
 4 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/lib/vecs-physics/src/adapter/engine.ts b/lib/vecs-physics/src/adapter/engine.ts
index 565f9a4..1dcfc97 100644
--- a/lib/vecs-physics/src/adapter/engine.ts
+++ b/lib/vecs-physics/src/adapter/engine.ts
@@ -107,6 +107,9 @@ export class PhysicsEngine {
   // check id generations in hot lookups: correctness comes from clearing each
   // slot on Box2D destruction before Box2D can reuse that index1.
   public readonly entityByBodyIndex = new ArrayMap<EID>();
+  /** The entity objects behind `entityByBodyIndex`, by body index1: pose-out reads them directly
+   * instead of resolving the EID every step. Set and cleared together with that map. */
+  public readonly bodyEntities: (Entity | undefined)[] = [];
   public readonly entityByShapeIndex = new ArrayMap<EID>();
 
   // Bodies whose mass needs recomputing this step (populated by shape lifecycle).
diff --git a/lib/vecs-physics/src/body/lifecycle.ts b/lib/vecs-physics/src/body/lifecycle.ts
index a5cf90f..6ac48da 100644
--- a/lib/vecs-physics/src/body/lifecycle.ts
+++ b/lib/vecs-physics/src/body/lifecycle.ts
@@ -34,6 +34,7 @@ export class BodyLifecycleModule extends Module {
         const bodyId = createWasmBodyId(engine, entity, body);
         body._bodyId = bodyId;
         engine.entityByBodyIndex.set(bodyId.index1, entity.eid);
+        engine.bodyEntities[bodyId.index1] = entity;
       })
       .update(Body, (entity, body) => {
         const bodyId = body._bodyId;
diff --git a/lib/vecs-physics/src/body/pose_out.ts b/lib/vecs-physics/src/body/pose_out.ts
index ac20081..6801583 100644
--- a/lib/vecs-physics/src/body/pose_out.ts
+++ b/lib/vecs-physics/src/body/pose_out.ts
@@ -45,20 +45,16 @@ export class BodyPoseOutModule extends Module {
       .run(() => {
         // One crossing exports every move event (Box2D's order) with its angle and velocities.
         const exporter = engine.moveExporter;
+        const bodyEntities = engine.bodyEntities;
         const count = exporter.exportMoves(engine.world, flags);
         const i32 = fast.i32;
         const f32 = fast.f32;
         const stride = exporter.stride;
         let base = exporter.base;
         for (let i = 0; i < count; i++, base += stride) {
-          const entityId = engine.entityByBodyIndex.get(i32[base + offsets.bodyIndex]);
-          if (entityId === undefined) {
-            continue;
-          }
-
           // A postStep system may destroy an entity after Box2D produced this event.
           // Keep the reverse slot until the reaper frees the body; lookup is O(1).
-          const entity = world.getEntity(entityId);
+          const entity = bodyEntities[i32[base + offsets.bodyIndex]!];
           if (entity === undefined || entity.destroyed) {
             continue;
           }
diff --git a/lib/vecs-physics/src/core/reaper.ts b/lib/vecs-physics/src/core/reaper.ts
index 68173fc..56544c6 100644
--- a/lib/vecs-physics/src/core/reaper.ts
+++ b/lib/vecs-physics/src/core/reaper.ts
@@ -48,6 +48,7 @@ export class PhysicsReaperModule extends Module {
         if (bodies.length > 0) {
           for (const bodyId of bodies) {
             engine.entityByBodyIndex.delete(bodyId.index1);
+            engine.bodyEntities[bodyId.index1] = undefined;
             engine.box2d.b2DestroyBody(bodyId);
           }
           bodies.length = 0;
-- 
2.43.0

