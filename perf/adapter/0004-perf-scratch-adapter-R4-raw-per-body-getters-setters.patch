+import { rev } from "../adapter/runtime.js";
 import {
   getPhysicsEngine,
   PhysicsSystemTag,
@@ -80,9 +80,13 @@ function drainLinearImpulses(engine: PhysicsEngine): void {
     if (!engine.entityByBodyIndex.has(bodyId.index1)) {
