From 468e831fc9759557f14e8388eac8d43a202f388e Mon Sep 17 00:00:00 2001
From: scratch <jm@peletier.com>
Date: Tue, 13 Oct 2026 00:18:38 +0000
Subject: [PATCH 4/7] perf: scratch adapter R4 - raw per-body getters/setters
 for pose-in, forces, impulses, kinematic targets, bodyMotion (local only)

---
 lib/vecs-physics/src/adapter/queries.ts   | 43 +++++++++---------
 lib/vecs-physics/src/adapter/runtime.ts   |  8 ++++
 lib/vecs-physics/src/body/pose_in.ts      | 33 +++++---------
 lib/vecs-physics/src/forces/gather.ts     | 19 +++++---
 lib/vecs-physics/src/forces/impulses.ts   | 19 +++++---
 lib/vecs-physics/src/kinematic/targets.ts | 53 +++++++++++++----------
 6 files changed, 99 insertions(+), 76 deletions(-)

diff --git a/lib/vecs-physics/src/adapter/queries.ts b/lib/vecs-physics/src/adapter/queries.ts
index a9cf028..1fc1e0c 100644
--- a/lib/vecs-physics/src/adapter/queries.ts
+++ b/lib/vecs-physics/src/adapter/queries.ts
@@ -17,7 +17,9 @@ import {
   scr_b2AABB,
   scr_b2QueryFilter,
   scr_b2ShapeProxy,
+  rev,
   scr_b2Vec2,
+  scr_fastOut,
   type Box2DModule,
 } from "./runtime.js";
 import {
@@ -240,34 +242,33 @@ class PhysicsQueriesImpl implements PhysicsQueries {
     if (body === undefined || bodyId === undefined) {
       return false;
     }
-    const { box2d } = this.engine;
-    out.awake = box2d.b2Body_IsAwake(bodyId);
-    const linear = box2d.b2Body_GetLinearVelocity(bodyId);
-    try {
-      out.vx = linear.x;
-      out.vy = linear.y;
-    } finally {
-      linear.delete();
-    }
-    out.w = box2d.b2Body_GetAngularVelocity(bodyId);
-    out.linearDamping = box2d.b2Body_GetLinearDamping(bodyId);
-    out.angularDamping = box2d.b2Body_GetAngularDamping(bodyId);
-    const center = box2d.b2Body_GetLocalCenterOfMass(bodyId);
-    try {
-      out.localCenterX = center.x;
-      out.localCenterY = center.y;
-    } finally {
-      center.delete();
-    }
+    // The eight getters in one crossing, read in the same order (b2x_Body_GetMotion).
+    const fast = this.engine.fast;
+    fast.module._b2x_Body_GetMotion(bodyId.index1, rev(bodyId), scr_fastOut);
+    fast.sync();
+    const m = fast.layout.motion;
+    const f32 = fast.f32;
+    const at = scr_fastOut;
+    out.awake = fast.i32[(at + m.awake) >> 2] !== 0;
+    out.vx = f32[(at + m.vx) >> 2]!;
+    out.vy = f32[(at + m.vy) >> 2]!;
+    out.w = f32[(at + m.w) >> 2]!;
+    out.linearDamping = f32[(at + m.linearDamping) >> 2]!;
+    out.angularDamping = f32[(at + m.angularDamping) >> 2]!;
+    out.localCenterX = f32[(at + m.localCenterX) >> 2]!;
+    out.localCenterY = f32[(at + m.localCenterY) >> 2]!;
     // Box2D applies gravity times the scale only to a body with mass (src/solver.c:99).
-    out.gravityScale = box2d.b2Body_GetMass(bodyId) > 0 ? box2d.b2Body_GetGravityScale(bodyId) : 0;
+    out.gravityScale = f32[(at + m.mass) >> 2]! > 0 ? f32[(at + m.gravityScale) >> 2]! : 0;
     out.allowFastRotation = body.allowFastRotation;
     return true;
   }
 
   public isAwake(entity: Entity): boolean {
     const bodyId = entity.get(Body)?._bodyId;
-    return bodyId !== undefined && this.engine.box2d.b2Body_IsAwake(bodyId);
+    return (
+      bodyId !== undefined &&
+      this.engine.fast.module._b2x_Body_IsAwake(bodyId.index1, rev(bodyId)) !== 0
+    );
   }
 
   public settings(): PhysicsSettings {
diff --git a/lib/vecs-physics/src/adapter/runtime.ts b/lib/vecs-physics/src/adapter/runtime.ts
index 9ccf2a0..8cd822e 100644
--- a/lib/vecs-physics/src/adapter/runtime.ts
+++ b/lib/vecs-physics/src/adapter/runtime.ts
@@ -10,6 +10,8 @@ export type Box2DModule = Awaited<ReturnType<typeof Box2DFactory>>;
 let modulePromise: Promise<Box2DModule> | null = null;
 let module: Box2DModule | null = null;
 let fastPath: FastPath | null = null;
+/** 64-byte wasm scratch for fast-path out-parameters (pose, motion); non-reentrant like scr_*. */
+export let scr_fastOut = 0;
 
 // Global scratch pools for common Box2D structs. Allocated once at module load,
 // reused across queries and other non-reentrant operations.
@@ -33,6 +35,7 @@ export async function preloadPhysics(): Promise<void> {
   modulePromise = Box2DFactory().then((loadedModule) => {
     module = loadedModule;
     fastPath = createFastPath(loadedModule);
+    scr_fastOut = fastPath.alloc(64);
     // Box2D's profile timers read a clock (a JavaScript call) per timed section of every step,
     // only to fill b2World_GetProfile, which vecs never reads. They never affect results.
     fastPath.setProfileTimers(false);
@@ -78,6 +81,11 @@ export function getBox2D(): Box2DModule {
   return module;
 }
 
+/** `rev` half of a packed fast-path id: world0 | generation << 16. */
+export function rev(id: { world0: number; generation: number }): number {
+  return id.world0 | (id.generation << 16);
+}
+
 /** The b2x_ fast path over the loaded module: raw exports, struct layouts, memory views. */
 export function getFastPath(): FastPath {
   if (!fastPath) {
diff --git a/lib/vecs-physics/src/body/pose_in.ts b/lib/vecs-physics/src/body/pose_in.ts
