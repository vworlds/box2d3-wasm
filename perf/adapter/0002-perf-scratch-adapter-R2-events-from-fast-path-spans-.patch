+
+/** `Set.clear()` replaces V8's backing table; skip it when there is nothing to clear. */
+function clearSet(set: Set<EID>): void {
+  if (set.size > 0) {
+    set.clear();
+  }
+}
+
+function copySet(target: Set<EID>, source: Set<EID>): void {
+  clearSet(target);
+  for (const eid of source) {
+    target.add(eid);
+  }
 }
 
 function emitContactToEntity(
@@ -208,7 +287,9 @@ function emitHitToEntity(
