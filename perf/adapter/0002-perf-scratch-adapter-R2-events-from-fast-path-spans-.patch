-      try {
-        emitContactEvent(world, engine, touchedContact, event, "begin");
-      } finally {
-        deleteIfPresent(event);
-      }
-    }
+  const fast = engine.fast;
+  engine.box2d._b2x_World_GetContactSpans(engine.world, spans);
+  fast.sync();
+  const i32 = fast.i32;
+  const u32 = fast.u32;
+  const f32 = fast.f32;
+  const header = spans >> 2;
+  const c = offsets.contact;
+
+  const begin = offsets.begin;
+  let at = u32[header + c.beginPtr]! >> 2;
+  for (let i = 0, n = i32[header + c.beginCount]!; i < n; i++, at += begin.stride) {
+    emitContactEvent(world, engine, touchedContact, i32[at + begin.a]!, i32[at + begin.b]!, "begin");
+  }
 
-    for (let i = 0; i < events.endCount; i++) {
-      const event = events.GetEndEvent(i);
-      emitContactEvent(world, engine, touchedContact, event, "end");
-    }
+  const end = offsets.end;
+  at = u32[header + c.endPtr]! >> 2;
+  for (let i = 0, n = i32[header + c.endCount]!; i < n; i++, at += end.stride) {
+    emitContactEvent(world, engine, touchedContact, i32[at + end.a]!, i32[at + end.b]!, "end");
+  }
 
-    for (let i = 0; i < events.hitCount; i++) {
-      const event = events.GetHitEvent(i);
-      try {
-        emitHitEvent(world, engine, touchedHit, event);
-      } finally {
-        event.delete();
-      }
-    }
-  } finally {
-    events.delete();
+  const hit = offsets.hit;
+  at = u32[header + c.hitPtr]! >> 2;
+  for (let i = 0, n = i32[header + c.hitCount]!; i < n; i++, at += hit.stride) {
+    emitHitEvent(world, engine, touchedHit, i32, f32, at, hit);
   }
 }
 
-function publishSensorEvents(world: World, engine: PhysicsEngine, touched: Set<EID>): void {
